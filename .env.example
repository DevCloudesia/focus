# --- Focus app's own Supabase project ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Read-only access to the daily-fifty Supabase project, for the SAT progress widget ---
DAILY_FIFTY_SUPABASE_URL=
DAILY_FIFTY_SUPABASE_ANON_KEY=

# --- Google Calendar + Gmail (one-time personal OAuth client + refresh token, see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Slack (bot token(s) from a personal Slack app installed per-workspace, see README) ---
# Workspace 1 (required if using Slack at all):
SLACK_BOT_TOKEN=
SLACK_USER_ID=
SLACK_LABEL=
# Workspace 2 (optional — same app installed into a second workspace):
SLACK_BOT_TOKEN_2=
SLACK_USER_ID_2=
SLACK_LABEL_2=
# Workspace 3 / 4: SLACK_BOT_TOKEN_3/_4, SLACK_USER_ID_3/_4, SLACK_LABEL_3/_4

# --- Shared secret the browser extension uses to call this app's API ---
EXTENSION_SYNC_SECRET=

# --- Schoology's own calendar feed (Schoology → Settings → Calendar →
# Subscribe, gives you a webcal:// link — paste it here as-is). Private
# link, treat it like a secret. Synced into tasks daily. ---
SCHOOLOGY_ICS_URL=
