# --- Focus app's own Supabase project ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Read-only access to the daily-fifty Supabase project, for the SAT progress widget ---
DAILY_FIFTY_SUPABASE_URL=
DAILY_FIFTY_SUPABASE_ANON_KEY=

# --- Google Calendar + Gmail (one-time personal OAuth client + refresh token, see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Slack (bot token from a personal Slack app, see README) ---
SLACK_BOT_TOKEN=
SLACK_USER_ID=

# --- Shared secret the browser extension uses to call this app's API ---
EXTENSION_SYNC_SECRET=
